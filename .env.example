# Server-only. Never put these in assets/config.js or a page.
# api/stripe-webhook.js, api/support.js, and api/crawl-invites.js send through Resend.
RESEND_API_KEY=

# Inbox for the public /support form.
# When this is unset, api/support.js sends to hello@hometowncrawls.com.
SUPPORT_TO_EMAIL=hello@hometowncrawls.com

# Staging Supabase for organizer self-serve crawls.
# Set these on the Vercel Preview environment, pointed at a project that is
# not the live Puyallup database (ref tatwbjuwufeqynpufodq).
# Use the public anon key. Do not put a service role key in this file or in git.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Origin used in shop-invite links. On Vercel preview, leave this unset to use
# VERCEL_URL. Set it when the preview has a stable alias.
HC_APP_URL=
