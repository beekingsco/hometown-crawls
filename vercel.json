{
  "cleanUrls": true,
  "trailingSlash": false,
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/", "/(.*)"]
  },
  "rewrites": [
    {
      "source": "/shops/join",
      "destination": "/shops/join.html"
    },
    {
      "source": "/puyallupwa/coffee",
      "destination": "/puyallupwa/coffee/index.html"
    },
    {
      "source": "/puyallupwa/coffee/",
      "destination": "/puyallupwa/coffee/index.html"
    },
    {
      "source": "/puyallup/coffee-crawl",
      "destination": "/puyallup/coffee-crawl/index.html"
    },
    {
      "source": "/puyallup/coffee-crawl/thanks",
      "destination": "/puyallup/coffee-crawl/thanks/index.html"
    },
    {
      "source": "/puyallup/holiday-coffee-crawl",
      "destination": "/puyallup/holiday-coffee-crawl/index.html"
    },
    {
      "source": "/puyallup/coffee-crawl/shop",
      "destination": "/puyallup/coffee-crawl/shop/index.html"
    },
    {
      "source": "/puyallup/coffee-crawl/organizer",
      "destination": "/puyallup/coffee-crawl/organizer/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "sandbox\\.hometowncrawls\\.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/puyallup",
      "missing": [
        {
          "type": "host",
          "value": "sandbox\\.hometowncrawls\\.com"
        }
      ],
      "destination": "/puyallup/coffee-crawl",
      "permanent": false
    },
    {
      "source": "/puyallup/",
      "missing": [
        {
          "type": "host",
          "value": "sandbox\\.hometowncrawls\\.com"
        }
      ],
      "destination": "/puyallup/coffee-crawl",
      "permanent": false
    }
  ]
}
