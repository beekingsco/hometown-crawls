{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/shops/join", "destination": "/shops/join.html" },
    { "source": "/puyallupwa/coffee", "destination": "/puyallupwa/coffee/index.html" },
    { "source": "/puyallupwa/coffee/", "destination": "/puyallupwa/coffee/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
